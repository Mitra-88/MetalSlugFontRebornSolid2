{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "metalslugfontrebornsolid2",
    "compatibility_date": "2026-10-01",
    "workers_dev": true,
    "preview_urls": true,
    "observability": {
        "enabled": true
